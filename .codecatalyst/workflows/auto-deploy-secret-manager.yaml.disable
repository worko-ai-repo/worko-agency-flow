Name: DeploySecretManagerLambda
SchemaVersion: "1.0"

Triggers:
  - Type: PUSH
    Branches:
      - main
    FilePaths:
      - src/worko-secret-manager-dev/**

Actions:
  BuildAndDeploy:
    Identifier: aws/build@v1
    Inputs:
      Sources:
        - WorkflowSource
    Configuration:
      Steps:
        - Run: |
            echo "=== Cleaning up existing resources ==="
            
            # Check if Lambda exists and find its stack
            LAMBDA_ARN=$(aws lambda get-function --function-name worko-secret-manager-dev --region ap-south-1 --query 'Configuration.FunctionArn' --output text 2>/dev/null || echo "")
            
            if [ ! -z "$LAMBDA_ARN" ]; then
              echo "Lambda function exists: $LAMBDA_ARN"
              
              # Try to find which stack owns it
              OWNER_STACK=$(aws cloudformation describe-stack-resources --physical-resource-id worko-secret-manager-dev --region ap-south-1 --query 'StackResources[0].StackName' --output text 2>/dev/null || echo "")
              
              if [ ! -z "$OWNER_STACK" ] && [ "$OWNER_STACK" != "None" ]; then
                echo "Lambda is managed by stack: $OWNER_STACK"
                echo "Deleting stack: $OWNER_STACK"
                aws cloudformation delete-stack --stack-name "$OWNER_STACK" --region ap-south-1
                aws cloudformation wait stack-delete-complete --stack-name "$OWNER_STACK" --region ap-south-1 || true
              else
                echo "Lambda is not managed by CloudFormation, deleting manually"
                aws lambda delete-function --function-name worko-secret-manager-dev --region ap-south-1 || true
              fi
            else
              echo "Lambda function does not exist"
            fi
            
            # Delete target stack if it exists
            if aws cloudformation describe-stacks --stack-name worko-secret-manager-dev-stack --region ap-south-1 2>/dev/null; then
              echo "Deleting target stack: worko-secret-manager-dev-stack"
              aws cloudformation delete-stack --stack-name worko-secret-manager-dev-stack --region ap-south-1
              aws cloudformation wait stack-delete-complete --stack-name worko-secret-manager-dev-stack --region ap-south-1 || true
            fi
            
            echo "Cleanup completed"
        - Run: |
            echo "=== Building and Deploying ==="
            export AWS_REGION=ap-south-1
            export AWS_DEFAULT_REGION=ap-south-1
            
            cd src/worko-secret-manager-dev
            echo "Current directory: $(pwd)"
            ls -la
            
            echo "Building SAM application..."
            sam build --use-container
            BUILD_EXIT_CODE=$?
            
            if [ $BUILD_EXIT_CODE -ne 0 ]; then
              echo "ERROR: SAM build failed"
              exit 1
            fi
            
            echo "Deploying to CloudFormation..."
            sam deploy \
              --template-file .aws-sam/build/template.yaml \
              --stack-name worko-secret-manager-dev-stack \
              --region ap-south-1 \
              --capabilities CAPABILITY_IAM \
              --parameter-overrides Environment=dev \
              --s3-bucket aws-sam-cli-managed-default-samclisourcebucket-mpwvaft0yfqx \
              --on-failure DELETE \
              --no-confirm-changeset \
              --no-fail-on-empty-changeset
            
            DEPLOY_EXIT_CODE=$?
            
            if [ $DEPLOY_EXIT_CODE -ne 0 ]; then
              echo "ERROR: Deployment failed"
              aws cloudformation describe-stack-events --stack-name worko-secret-manager-dev-stack --region ap-south-1 --max-items 20 || true
              exit 1
            fi
            
            echo "SUCCESS: Deployment completed"
    Environment:
      Name: dev
    Compute:
      Type: EC2
